# One pin per compiler; the file name is the AUR package name. Pushing a new
# or changed pin to main builds and publishes it. A pin that already has a
# release is skipped, so a push never starts the multi-hour build by accident.

# The AUR package, and the recipe commit to build:
# https://aur.archlinux.org/packages/gcc14
AUR_PACKAGE=gcc14
AUR_REVISION=87e62884e433543b59aaa2a28dcceb2e6f314054

# The version that revision produces. The build fails if makepkg reports
# anything else, so a recipe change can't slip in under an old version.
PKGVER=14.4.1+r175+gafa9b4ecc082
PKGREL=1

# The pacman repository: the [section] in pacman.conf and the .db file name.
REPO_NAME=gcc14-arch
